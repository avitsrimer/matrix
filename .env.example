# =============================================================
#  Matrix Private Server — Environment Variables
#  Copy to .env and edit before running setup.sh
# =============================================================

# --- Server IP (required) ---
# Your public IP address. If running locally, use the LAN IP.
# setup.sh will auto-detect if left empty.
SERVER_IP=

# --- Postgres ---
POSTGRES_USER=synapse
POSTGRES_DB=synapse
# Auto-generated by setup.sh if left empty:
POSTGRES_PASSWORD=

# --- Synapse ---
# Auto-generated by setup.sh if left empty:
SYNAPSE_REGISTRATION_SHARED_SECRET=

# --- TURN (Coturn) ---
# Auto-generated by setup.sh if left empty:
TURN_SHARED_SECRET=

# --- TURN relay port range ---
TURN_MIN_PORT=49152
TURN_MAX_PORT=49999

# --- TLS certificate validity (days) ---
CERT_VALIDITY_DAYS=3650
